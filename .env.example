# Copy to .env.local for local development. On Vercel, set it in Project Settings > Environment Variables.
# Without it, the sports section runs in demo mode with clearly labelled simulated data.
API_FOOTBALL_KEY=

# Accounts (docs/accounts.md). Server-only: never prefix with VITE_. Without them, accounts stay off
# and the site says so; `npm run preview:contas` runs a local emulator instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters each.
ACCOUNT_HASH_SECRET=
PAYMENT_SANDBOX_WEBHOOK_SECRET=
CRON_SECRET=
